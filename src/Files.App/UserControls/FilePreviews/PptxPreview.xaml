<UserControl
	x:Class="Files.App.UserControls.FilePreviews.PptxPreview"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:previews="using:Files.App.ViewModels.Previews"
	mc:Ignorable="d">

	<GridView
		ItemsSource="{x:Bind ViewModel.Slides, Mode=OneWay}"
		SelectionMode="None">

		<GridView.ItemsPanel>
			<ItemsPanelTemplate>
				<ItemsWrapGrid Orientation="Horizontal" />
			</ItemsPanelTemplate>
		</GridView.ItemsPanel>

		<GridView.ItemTemplate>
			<DataTemplate x:DataType="previews:PptxSlide">
				<Grid
					Width="200"
					Margin="0,0,12,12"
					RowDefinitions="Auto,Auto,Auto">
					<Image
						Grid.Row="0"
						Height="112"
						Stretch="Uniform"
						Source="{x:Bind Thumbnail}" />
					<TextBlock
						Grid.Row="1"
						FontWeight="SemiBold"
						Text="{x:Bind NumberText}" />
					<TextBlock
						Grid.Row="2"
						MaxLines="2"
						Text="{x:Bind Text}"
						TextTrimming="CharacterEllipsis"
						TextWrapping="Wrap" />
				</Grid>
			</DataTemplate>
		</GridView.ItemTemplate>
	</GridView>
</UserControl>
